{% set hx = app.request.get('hx') %}

{% set availableServiceChecks = page.parameters.get('availableServiceChecks') %}
{% set assetServiceCheck = page.parameters.get('assetServiceCheck') %}
{% set assetId = page.parameters.get('assetId') %}
{% set checkScriptParameter = page.parameters.get('checkScriptParameter') %}
{% set assetServiceCheckConfig = page.parameters.get('assetServiceCheckConfig') %}

{% block page_title %}{% endblock %}
{% block page_heading %}{% endblock %}

{% block page_content %}
{% block edit_service_check_parameter %}
{% if checkScriptParameter is not empty %}
    <div class="form-group">
        {% for parameter in checkScriptParameter %}
            {% set parameterName = 'check-script-parameter[' ~ parameter.name ~ ']' %}

            {% if assetServiceCheckConfig.checkScriptParameter is not defined %}
                {% set parameterValue = '' %}
            {% else %}
                {% set parameterValue = assetServiceCheckConfig.checkScriptParameter[parameter.name] %}
            {% endif %}

            <label for="{{ parameterName }}">{{ parameter.name }}</label>
            <input type="text" class="form-control" name="{{ parameterName }}" value="{{ parameterValue }}">
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
{% endblock %}
