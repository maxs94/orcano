{% block listing_table_asset %}
{% set result = page.result %}
{% for row in result %}
{% set url = path('detail_check_result', {'id': row.id}) %}
{% set hxUrl = url ~ '?hx=1' %}
<tr>
    <td>{{ row.asset.hostname }}</td>
    <td>{{ row.serviceCheck.name }}</td>
    <td>{{ row.createdAt|date('d.m.Y H:i:s') }}</td>
    <td><a 
        class="btn btn-sm btn-primary"
        hx-get="{{ hxUrl }}"
        hx-target="#page-content"
        hx-push-url="{{ url }}"
        href="{{ url }}">{{ 'label.details'|trans }}</a></td>
</tr>
{% endfor %}

<tr>
    <td colspan="7">
    <span class="dataTable-pagination">{% include 'listing/pagination.html.twig' with { 'target': '#check-result-listing-body', 'pagination': page.pagination } %}</span> 
    </td>
</tr>

{% endblock %}
